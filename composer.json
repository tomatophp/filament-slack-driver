{
    "name": "tomatophp/filament-slack-driver",
    "type": "library",
    "description": "Slack Channel Integration for Filament Alerts Sender",
    "keywords": [
        "php",
        "laravel",
        "slack",
        "slack-integration",
        "slack-webhook",
        "slack-notification",
        "filament-plugin"
    ],
    "homepage": "https://tomatophp.com/en/plugins/filament-slack-driver",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "TomatoPHP\\FilamentSlackDriver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TomatoPHP\\FilamentSlackDriver\\Tests\\": "tests/src/",
            "TomatoPHP\\FilamentSlackDriver\\Tests\\Database\\Factories\\": "tests/database/factories"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TomatoPHP\\FilamentSlackDriver\\FilamentSlackDriverServiceProvider"
            ]
        }
    },
    "authors": [
        {
            "name": "Fady Mondy",
            "email": "info@3x1.io"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "testbench": "vendor/bin/testbench package:discover --ansi",
        "db": "vendor/bin/testbench package:create-sqlite-db && vendor/bin/testbench migrate",
        "analyse": "vendor/bin/phpstan analyse src tests",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "filament/notifications": "^5.0",
        "mallardduck/blade-boxicons": "^2.4",
        "tomatophp/console-helpers": "^1.1",
        "tomatophp/filament-alerts": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-arch": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0|^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "version": "5.0.0"
}
